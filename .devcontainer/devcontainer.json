{
  "name": "Python + SQL Server",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-mssql.mssql"]
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install pymssql",
  "forwardPorts": [1433]
}
